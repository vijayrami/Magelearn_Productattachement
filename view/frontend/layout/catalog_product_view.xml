<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.details">
            <block class="Magento\Framework\View\Element\Template" name="attachment.tab" as="attachment"
                   template="Magelearn_Productattachement::downloads.phtml" group="detailed_info">
                <arguments>
                	<argument translate="true" name="title" xsi:type="string">Product Attachment</argument>
                    <argument name="view_model" xsi:type="object">
                        Magelearn\Productattachement\ViewModel\Attachment
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>